// Deploy gb-website on every push to main.
//
// mm-jenkins runs on mycelium (see mm-documents/MM_ARCHITECTURE.md), so
// `agent any` lands on the same docker host that runs the gb-website
// container — no ssh hop, no registry round-trip. Build and run are
// both local (mirrors mm-sporekles/Jenkinsfile.deploy). The deploy
// stage renders secrets.env from Jenkins credentials into the workspace
// each build (withCredentials + heredoc + chmod 600 + atomic mv) so the
// on-host file is no longer hand-managed.
//
// Credentials needed in Jenkins (provisioned by mm-jenkins JCasC):
//   gb-website-secret-key        — Flask SECRET_KEY (string)
//   gb-website-oidc-client-id    — FA OIDC client ID (string)
//   gb-website-oidc-client-secret — FA OIDC client secret (string)
//
// gb-website-smtp (Fastmail) is deferred — Fastmail account not yet
// provisioned. app/services/email.py early-returns when SMTP_HOST is
// unset, so inquiries still persist to the DB; they just don't trigger
// a notification email. When ready, add the usernamePassword block to
// withCredentials below + SMTP_HOST / SMTP_PORT / SMTP_USER /
// SMTP_PASSWORD lines to the heredoc, and add the matching block to
// mm-jenkins/jenkins.yaml + .env.example + docker-compose.yml.
//
// Non-secret config (OIDC discovery URL, sporekles API base, CDN base,
// SMTP from, contact email, tenant) is inlined in the secrets.env
// heredoc below — no value in routing through Jenkins.

pipeline {
    agent any

    options { timestamps() }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Lint + Test') {
            agent { docker { image 'python:3.12-slim'; reuseNode true } }
            steps {
                sh '''
                    pip install --no-cache-dir -e ".[dev]"
                    ruff check app tests scripts
                    pytest -v
                '''
            }
        }

        stage('Build image') {
            steps {
                // Local build — image is consumed on this same host. No
                // registry push (matches mm-sporekles pattern). The
                // `image:` tag in docker-compose.yml ties the compose
                // service to the locally-built artifact.
                sh 'docker compose build'
            }
        }

        stage('Deploy') {
            steps {
                // SMTP credentials deferred — Fastmail account not yet
                // provisioned. app/services/email.py early-returns when
                // SMTP_HOST is unset, so contact-form inquiries still
                // persist to the DB; they just don't trigger a notification
                // email. Re-add `usernamePassword(credentialsId:
                // 'gb-website-smtp', ...)` + the matching SMTP_HOST /
                // SMTP_PORT / SMTP_USER / SMTP_PASSWORD lines in the
                // heredoc when ready. Companion JCasC block is documented
                // in mm-jenkins/jenkins.yaml comment.
                withCredentials([
                    string(credentialsId: 'gb-website-secret-key',          variable: 'SECRET_KEY'),
                    string(credentialsId: 'gb-website-oidc-client-id',      variable: 'OIDC_CLIENT_ID'),
                    string(credentialsId: 'gb-website-oidc-client-secret',  variable: 'OIDC_CLIENT_SECRET'),
                ]) {
                    sh '''
                        set -eu
                        # Render secrets.env atomically (write-then-rename) so a
                        # half-written file can't be picked up by a parallel
                        # `docker compose` call.
                        umask 077
                        cat > secrets.env.tmp <<EOF
SECRET_KEY=$SECRET_KEY
OIDC_CLIENT_ID=$OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=$OIDC_CLIENT_SECRET
OIDC_DISCOVERY_URL=https://auth.musicalmycology.org/.well-known/openid-configuration
OIDC_GROUP_REQUIRED=gb-developer
CDN_BASE_URL=https://design-assets.grogblossoms.com/
SPOREKLES_API_BASE=http://mm-sporekles-api:3000
SPOREKLES_TENANT=gb
SMTP_FROM=no-reply@grogblossoms.com
CONTACT_EMAIL=chris@grogblossoms.com
EOF
                        chmod 600 secrets.env.tmp
                        mv secrets.env.tmp secrets.env

                        set -x
                        docker compose up -d --wait
                    '''
                }
            }
        }

        stage('Smoke') {
            steps {
                sh 'curl -fsS --max-time 30 https://www.grogblossoms.com/healthz || (echo "Healthcheck failed" && exit 1)'
            }
        }
    }

    post {
        failure {
            echo 'Deploy failed'
        }
    }
}
