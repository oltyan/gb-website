// Build gb-website and publish its image on every push to main.
//
// Build runs on the Jenkins controller (EC2). Deploy runs on mycelium by
// pull: a launchd timer there runs /opt/gb-website/deploy-pull.sh every
// 5 minutes, which pulls :latest from ECR, retags it to the local name the
// compose file uses (gb-website:latest) and recreates the container. Set
// FORCE_DEPLOY to trigger that script immediately instead of waiting.
//
// A green build therefore means "image published", not "site updated".
// The deploy result is in ~/Library/Logs/gb-website-deploy.log on mycelium.
//
// This pipeline does not read, render or ship application secrets. The
// container's env file lives on mycelium and is maintained there; Jenkins
// on EC2 cannot write to mycelium's filesystem. See docs/runbook-deploy.md
// ("Rotate a secret").
//
// Design: docs/specs/2026-11-16-jenkins-deploy-migration-design.md
//
// Credentials needed in Jenkins (already provisioned by mm-jenkins JCasC):
//   cf-deploy-trigger-token-id      — Cloudflare Access service token for the
//   cf-deploy-trigger-token-secret    force-deploy webhook (FORCE_DEPLOY only).

pipeline {
    agent any

    triggers {
        pollSCM('H/5 * * * *')
    }

    parameters {
        booleanParam(
            name: 'FORCE_DEPLOY',
            defaultValue: false,
            description: 'After ECR push, POST to mycelium.musicalmycology.org/_deploy-trigger/gb-website to deploy immediately. Otherwise the launchd timer on mycelium picks it up within 5 min.'
        )
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Lint + Test') {
            agent { docker { image 'python:3.12-slim'; reuseNode true } }
            steps {
                sh '''
                    pip install --no-cache-dir -e ".[dev]"
                    ruff check app tests scripts
                    pytest -v
                '''
            }
        }

        stage('Build + push to ECR') {
            steps {
                // No role-assumption wrapper: the EC2 instance already is the
                // Jenkins instance role, and its ecr-push policy covers the
                // gb-website repository (mm-jenkins terraform, consumer_ecr).
                sh '''
                    set -euxo pipefail
                    # docker login takes the registry HOST, not a repository
                    # path; logging in to the repo path "succeeds" but the
                    # push then finds no credential.
                    ECR_HOST=365647376064.dkr.ecr.us-east-1.amazonaws.com
                    ECR="${ECR_HOST}/gb-website"
                    SHA=$(git rev-parse --short HEAD)
                    aws ecr get-login-password --region us-east-1 \
                      | docker login --username AWS --password-stdin "$ECR_HOST"
                    docker build -t "gb-website:${SHA}" .
                    docker tag  "gb-website:${SHA}" "${ECR}:${SHA}"
                    docker tag  "gb-website:${SHA}" "${ECR}:latest"
                    docker push "${ECR}:${SHA}"
                    docker push "${ECR}:latest"
                '''
            }
        }

        stage('Force deploy on Mycelium') {
            when { expression { params.FORCE_DEPLOY } }
            steps {
                withCredentials([
                    string(credentialsId: 'cf-deploy-trigger-token-id',     variable: 'CF_DEPLOY_TOKEN_ID'),
                    string(credentialsId: 'cf-deploy-trigger-token-secret', variable: 'CF_DEPLOY_TOKEN_SECRET'),
                ]) {
                    sh '''
                        set -eu
                        curl -fsS -X POST \
                          -H "CF-Access-Client-Id: ${CF_DEPLOY_TOKEN_ID}" \
                          -H "CF-Access-Client-Secret: ${CF_DEPLOY_TOKEN_SECRET}" \
                          https://mycelium.musicalmycology.org/_deploy-trigger/gb-website
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'Build failed'
        }
    }
}
