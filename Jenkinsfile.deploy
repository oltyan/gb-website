// Deploy gb-website on every push to main.
//
// mm-jenkins runs on mycelium (see mm-documents/MM_ARCHITECTURE.md), so
// `agent any` lands on the same docker host that runs the gb-website
// container — no ssh hop needed. The deploy stage renders secrets.env
// from Jenkins credentials into the workspace each build (mirrors
// mm-sporekles' Jenkinsfile.deploy `Deploy` stage — withCredentials +
// heredoc + chmod 600 + atomic mv) so the on-host file is no longer
// hand-managed.
//
// Credentials needed in Jenkins (provisioned by mm-jenkins JCasC):
//   ghcr-push                    — GHCR push token (image publish)
//   gb-website-secret-key        — Flask SECRET_KEY (string)
//   gb-website-oidc-client-id    — FA OIDC client ID (string)
//   gb-website-oidc-client-secret — FA OIDC client secret (string)
//   gb-website-smtp              — Fastmail SMTP (usernamePassword:
//                                   username -> SMTP_USER,
//                                   password -> SMTP_PASSWORD)
//
// Non-secret config (OIDC discovery URL, sporekles API base, CDN base,
// SMTP host/port/from, contact email, tenant) is inlined in the
// secrets.env heredoc below — no value in routing through Jenkins.

pipeline {
    agent any

    environment {
        IMAGE = "ghcr.io/oltyan/gb-website"
        GHCR  = credentials('ghcr-push')
    }

    options { timestamps(); ansiColor('xterm') }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Lint + Test') {
            agent { docker { image 'python:3.12-slim'; reuseNode true } }
            steps {
                sh '''
                    pip install --no-cache-dir -e ".[dev]"
                    ruff check app tests scripts
                    pytest -v
                '''
            }
        }

        stage('Build + push') {
            steps {
                sh '''
                    echo "$GHCR_PSW" | docker login ghcr.io -u "$GHCR_USR" --password-stdin
                    SHA=$(git rev-parse --short HEAD)
                    docker build -t $IMAGE:$SHA -t $IMAGE:latest .
                    docker push $IMAGE:$SHA
                    docker push $IMAGE:latest
                '''
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                    string(credentialsId: 'gb-website-secret-key',          variable: 'SECRET_KEY'),
                    string(credentialsId: 'gb-website-oidc-client-id',      variable: 'OIDC_CLIENT_ID'),
                    string(credentialsId: 'gb-website-oidc-client-secret',  variable: 'OIDC_CLIENT_SECRET'),
                    usernamePassword(credentialsId: 'gb-website-smtp',      usernameVariable: 'SMTP_USER', passwordVariable: 'SMTP_PASSWORD'),
                ]) {
                    sh '''
                        set -eu
                        # Render secrets.env atomically (write-then-rename) so a
                        # half-written file can't be picked up by a parallel
                        # `docker compose` call.
                        umask 077
                        cat > secrets.env.tmp <<EOF
SECRET_KEY=$SECRET_KEY
OIDC_CLIENT_ID=$OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=$OIDC_CLIENT_SECRET
OIDC_DISCOVERY_URL=https://auth.musicalmycology.org/.well-known/openid-configuration
OIDC_GROUP_REQUIRED=gb-developer
CDN_BASE_URL=https://design-assets.grogblossoms.com/
SPOREKLES_API_BASE=http://mm-sporekles-api:3000
SPOREKLES_TENANT=gb
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=587
SMTP_USER=$SMTP_USER
SMTP_PASSWORD=$SMTP_PASSWORD
SMTP_FROM=no-reply@grogblossoms.com
CONTACT_EMAIL=chris@grogblossoms.com
EOF
                        chmod 600 secrets.env.tmp
                        mv secrets.env.tmp secrets.env

                        set -x
                        docker compose pull
                        docker compose up -d
                    '''
                }
            }
        }

        stage('Smoke') {
            steps {
                sh 'curl -fsS --max-time 30 https://www.grogblossoms.com/healthz || (echo "Healthcheck failed" && exit 1)'
            }
        }
    }

    post {
        failure {
            echo 'Deploy failed'
        }
    }
}
